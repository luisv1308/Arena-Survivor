-- NewPlayer.script
local Barbarian = require "main/objects/player/Barbarian"
-- Script modular para manejar al jugador
local Animation = require "main/objects/player/Animation"
local Movement = require "main/objects/player/Movement"
local Combat = require "main/objects/player/Combat"
local StateMachine = require "main.state_machine"

function init(self)
	msg.post(".", "acquire_input_focus")

	-- Inicializar atributos básicos
	self.health = 100
	self.max_health = 100
	self.energy = 50
	self.max_energy = 50
	self.base_speed = 100
	self.moving = false
	self.attack_power = 10
	self.attack_cooldown = 1
	self.last_attack_time = 0
	self.attacking = false
	self.input = vmath.vector3(0, 0, 0)
	self.dir = vmath.vector3(0, 0, 0)
	self.player_face_dir = vmath.vector3(1, 0, 0) -- Inicialmente mirando a la derecha
	self.push_force = vmath.vector3(0, 0, 0) -- Fuerza de empuje inicial
    self.is_pushed = false -- Bandera para saber si está siendo empujado
	self.input_queue = {}
	self.inputs_released = { left = true, right = true, up = true, down = true } -- check if input is released
	self.move_keys = {
		[hash("up")] = true,
		[hash("down")] = true,
		[hash("left")] = true,
		[hash("right")] = true
	}
	self.attack_keys = {
		[hash("attack_left")] = true,
		[hash("attack_right")] = true,
		[hash("attack_up")] = true,
		[hash("attack_down")] = true
	}

	-- Inicializar máquina de estados
	self.state_machine = StateMachine.new()
	init_state_machine(self)
	msg.post("#attackcollision", "disable") -- Habilitar el collisionobject del ataque
end

function update(self, dt)
	self.state_machine:update(dt)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("set_player_type") then
		if message.type == "barbarian" then
			self.barbarian = Barbarian:new()
			self.url = message.url
			self.player_url = message.player_url
			self.base_speed = self.barbarian.speed
			print(self.barbarian.name .. " spawned with " .. self.barbarian.health .. " health.")
		end
	end

	--check collision
    if message_id == hash("contact_point_response") then
		if message.group == hash("enemy") then
			print("Colisionaste con un enemigo!".. message_id)
			--[[ if not self.invulnerable then
				self.health = self.health - 10
				print("Salud restante: " .. self.health)
			end ]]
			
			-- Calcular dirección de empuje
			local player_pos = go.get_position() -- Posición del jugador

			local enemy_pos = message.position -- Posición del enemigo (de la colisión)
			local player_push_direction = vmath.normalize(player_pos - enemy_pos)			
			-- Aplica la fuerza de empuje
			self.push_force = player_push_direction * 200 -- Ajusta la magnitud del empuje
            -- Cambia al estado pushed
			self.state_machine:set_state("pushed")			
		end
    end
end

function on_input(self, action_id, action)
	-- Agregar a la cola de inputs
	table.insert(self.input_queue, { action_id = action_id, action = action })

	-- Si está atacando, ignorar otros inputs
	if self.state_machine:get_state() == "attacking" then return end

	-- Manejar inputs de movimiento
	if self.move_keys[action_id] then
		if action.pressed then
			self.state_machine:set_state("walking")
		elseif action.released then
			self.state_machine:set_state("idle")
		end
	end

	-- Manejar inputs de ataque
	if action_id == hash("attack") and action.pressed then
		self.state_machine:set_state("attacking")
	end
end

function calculate_player_push_direction(self)
	local player_pos = go.get_position()
	local push_direction = vmath.normalize(self.input)
	return push_direction
end

function init_state_machine(self)
	

	-- Estado "idle"
	self.state_machine:add_state("idle", {
		enter = function()
			print("idle fucka")
			Animation.play_animation(self, "idle")
		end,
		update = function(dt)
			if next(self.input_queue) then
				self.state_machine:set_state("walking")
			end
		end
	})

	-- Estado "walking"
	self.state_machine:add_state("walking", {
		enter = function()
			--Animation.play_animation(self, "walk")
		end,
		update = function(dt)
			Movement.move(self, dt)
			if next(self.input_queue) then
				for _, input in ipairs(self.input_queue) do
					Movement.handle_input(self, input.action_id, input.action, Animation)
				end
				self.input_queue = {}
			else
				self.state_machine:set_state("idle")
			end
		end
	})

	-- Estado "attacking"
	self.state_machine:add_state("attacking", {
		enter = function()
			-- Si hay movimiento, cambiar la dirección y la animación
            local size_vector = vmath.length(self.input)
            if size_vector > 0 then
                self.dir = vmath.normalize(self.input) -- Normalizamos el vector de dirección
    
                -- Determinar si el personaje mira a la izquierda o derecha
                if self.dir.x > 0 then
                    go.set_rotation(vmath.quat(), "#sprite") -- Orientación normal (mirando a la derecha)
                    self.player_face_dir.x = 1
                elseif self.dir.x < 0 then
                    go.set_rotation(vmath.quat_rotation_y(math.pi), "#sprite") -- Reflejar horizontalmente (mirando a la izquierda)
                    self.player_face_dir.x = -1
                end
    
                -- Cambiar animación de ataque según dirección vertical
                if self.dir.y > 0 then
                    Animation.play_animation(self, "attack_up")
                elseif self.dir.y < 0 then
                    Animation.play_animation(self, "attack_down")
                else
                    Animation.play_animation(self, "attack") -- Animación neutral si no hay dirección vertical
                end
            else
                -- Sin movimiento: usar dirección actual para reflejar el sprite
                if self.player_face_dir.x > 0 then
                    go.set_rotation(vmath.quat(), "#sprite")
                else
                    go.set_rotation(vmath.quat_rotation_y(math.pi), "#sprite")
                end
    
                -- Animación neutral de ataque
                Animation.play_animation(self, "attack")
            end
    
            -- Configurar un temporizador para salir del estado de ataque
            self.attack_timer = self.attack_cooldown
            msg.post("#attackcollision", "enable") -- Habilitar el collisionobject del ataque
		end,
		update = function(dt)
			self.attack_timer = self.attack_timer - dt
			if self.attack_timer <= 0 then
				self.state_machine:set_state("idle")
			end
		end,
		exit = function()
			--Combat.end_attack(self)
			-- restaurar sprite rotacion a normal
			go.set_rotation(vmath.quat(), "#sprite")
			print("Exiting attacking state")
			msg.post("#attackcollision", "disable") -- Deshabilitar el collisionobject del ataque
		end
	})

	-- Estado "pushed"
	self.state_machine:add_state("pushed", {
		enter = function()
			-- Configurar la animación de empuje (opcional)
			--Animation.play_animation(self, "pushed")
			-- Ejemplo de efecto visual
			msg.post("@render:", "shake", { intensity = 5, duration = 0.2 })
			-- La fuerza de empuje ya debe estar configurada al entrar en este estado
		end,
		update = function(dt)
			-- Mover al jugador según la fuerza de empuje
			local current_position = go.get_position()
			local new_position = current_position + self.push_force * dt
			go.set_position(new_position)

			-- Reducir gradualmente la fuerza de empuje
			self.push_force = self.push_force * 0.9 -- Ajusta el factor de desaceleración
			if vmath.length(self.push_force) < 1 then
				self.state_machine:set_state("idle") -- Volver al estado idle cuando el empuje termine
			end
		end,
		exit = function()
			-- Lógica al salir del estado pushed, si es necesario
			self.push_force = vmath.vector3(0, 0, 0) -- Reiniciar la fuerza de empuje
		end
	})

	-- Estado inicial
	self.state_machine:set_state("idle")
end
