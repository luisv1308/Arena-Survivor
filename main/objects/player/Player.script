-- player.script

function init(self)
    msg.post(".", "acquire_input_focus")
    self.speed = 100  -- Velocidad de movimiento
    self.input = vmath.vector3(0, 0, 0)  -- Dirección de movimiento
    self.moving = false  -- Estado de movimiento
    self.dir = vmath.vector3(0, 0, 0)  -- Dirección del movimiento
    self.current_animation = nil  -- Almacena la animación actual
end

function update(self, dt)
    if self.moving then
        local pos = go.get_position()
        pos = pos + self.dir * self.speed * dt  -- Mueve al jugador en la dirección especificada
        go.set_position(pos)
    end
end

function on_input(self, action_id, action)
    -- Controlar direcciones de movimiento
    if action_id == hash("left") then
        if action.pressed then
			self.input.x = -1
		elseif action.released then
			self.input.x = 0
		end
	elseif action_id == hash("right") then
		if action.pressed then
			self.input.x = 1
		elseif action.released then
			self.input.x = 0
		end
	elseif action_id == hash("up") then
		if action.pressed then
			self.input.y = 1
		elseif action.released then
			self.input.y = 0
		end
	elseif action_id == hash("down") then
		if action.pressed then
			self.input.y = -1
		elseif action.released then
			self.input.y = 0
		end
	end
    -- Si hay movimiento, cambiar la dirección y la animación
    local size_vector = vmath.length(self.input)
    if size_vector > 0 then
        self.moving = true
        self.dir = vmath.normalize(self.input)  -- Normalizamos el vector de dirección

        -- Cambiar la animación de acuerdo con la dirección
        if self.input.y > 0 then
            play_animation(self, "walk")
        elseif self.input.y < 0 then
            play_animation(self, "walk")
        elseif self.input.x > 0 then
            play_animation(self, "walk")
        elseif self.input.x < 0 then
            play_animation(self, "walk")
        end
    else
        self.moving = false
        play_animation(self, "idle")  -- Si no hay movimiento, poner la animación en idle
    end
end

function play_animation(self, animation)
    -- Solo cambia la animación si es diferente de la actual
    if self.current_animation ~= animation then
        msg.post("Barbarian#sprite", "play_animation", { id = hash(animation) })
        self.current_animation = animation
    end
end
