-- player.script
-- agregar caracteristicas al basicas del jugador

local Animation = require "main/objects/player/Animation"
local Movement = require "main/objects/player/Movement"
local Combat = require "main/objects/player/Combat"

function init(self)
    msg.post(".", "acquire_input_focus")
    -- Atributos básicos del jugador
    self.health = 100               -- Salud actual del jugador
    self.max_health = 100           -- Salud máxima del jugador
    self.energy = 50                -- Energía o stamina del jugador
    self.max_energy = 50            -- Energía máxima
    
    -- Atributos de combate
    self.attack_power = 10          -- Poder de ataque (daño que inflige)
    self.attack_speed = 1           -- Velocidad de ataque (segundos entre ataques)
    self.attack_range = 30          -- Rango de ataque (distancia máxima)
    
    -- Atributos de movimiento
    self.base_speed = 100           -- Velocidad base de movimiento
    self.moving = false             -- Estado de movimiento (verdadero si se está moviendo)
    self.player_face_dir = vmath.vector3(0, 0, 0)
    self.input = vmath.vector3(0, 0, 0)  -- Dirección de movimiento
    self.dir = vmath.vector3(0, 0, 0)  -- Dirección del movimiento

    -- Estado y control de daño
    self.invulnerable = false       -- Estado de invulnerabilidad (verdadero si es invulnerable)
    self.damage_cooldown = 1        -- Tiempo de recuperación tras recibir daño (en segundos)
    self.last_damage_time = 0       -- Última vez que recibió daño, para gestionar el cooldown
    
    -- Atributos de juego y progresión
    self.score = 0                  -- Puntuación o experiencia del jugador
    self.state = "idle"             -- Estado del jugador: "idle", "walking", "attacking", etc.
    
    -- Otras variables de animación
    self.current_animation = nil    -- Para rastrear la animación actual y evitar cambios

    
    self.inputs_released = { left = true, right = true, up = true, down = true } -- check if input is released
    
end

function update(self, dt)
    Movement.move(self, dt)

    Combat.cooldown(self, dt)
end



function on_input(self, action_id, action)
    Movement.handle_input(self, action_id, action, Animation)
end



