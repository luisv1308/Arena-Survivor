-- player.script
-- agregar caracteristicas al basicas del jugador

local input_left = hash("left")
local input_right = hash("right")
local input_up = hash("up")
local input_down = hash("down")

function init(self)
    msg.post(".", "acquire_input_focus")
    -- Atributos básicos del jugador
    self.health = 100               -- Salud actual del jugador
    self.max_health = 100           -- Salud máxima del jugador
    self.energy = 50                -- Energía o stamina del jugador
    self.max_energy = 50            -- Energía máxima
    
    -- Atributos de combate
    self.attack_power = 10          -- Poder de ataque (daño que inflige)
    self.attack_speed = 1           -- Velocidad de ataque (segundos entre ataques)
    self.attack_range = 30          -- Rango de ataque (distancia máxima)
    
    -- Atributos de movimiento
    self.base_speed = 100           -- Velocidad base de movimiento
    self.moving = false             -- Estado de movimiento (verdadero si se está moviendo)
    self.player_face_dir = vmath.vector3(0, 0, 0)
    self.input = vmath.vector3(0, 0, 0)  -- Dirección de movimiento
    self.dir = vmath.vector3(0, 0, 0)  -- Dirección del movimiento

    -- Estado y control de daño
    self.invulnerable = false       -- Estado de invulnerabilidad (verdadero si es invulnerable)
    self.damage_cooldown = 1        -- Tiempo de recuperación tras recibir daño (en segundos)
    self.last_damage_time = 0       -- Última vez que recibió daño, para gestionar el cooldown
    
    -- Atributos de juego y progresión
    self.score = 0                  -- Puntuación o experiencia del jugador
    self.state = "idle"             -- Estado del jugador: "idle", "walking", "attacking", etc.
    
    -- Otras variables de animación
    self.current_animation = nil    -- Para rastrear la animación actual y evitar cambios

    
    self.inputs_released = { left = true, right = true, up = true, down = true } -- check if input is released
    
end

function update(self, dt)
    if self.moving then
        local pos = go.get_position()
        pos = pos + self.dir * self.base_speed  * dt  -- Mueve al jugador en la dirección especificada
        go.set_position(pos)
    end

    -- Ejemplo de gestión de estado "damage cooldown"
    if self.invulnerable and socket.gettime() - self.last_damage_time >= self.damage_cooldown then
        self.invulnerable = false
    end
end

-- Ejemplo de recibir daño con invulnerabilidad y cooldown
function take_damage(self, damage)
    if not self.invulnerable then
        self.health = self.health - damage
        self.invulnerable = true
        self.last_damage_time = socket.gettime()

        if self.health <= 0 then
            self.state = "dead"
            play_animation(self, "dead")
        else
            self.state = "damaged"
            play_animation(self, "damage")
        end
    end
end

function on_input(self, action_id, action)
    -- Controlar direcciones de movimiento
    if action_id == input_left then
        if action.pressed then
			self.input.x = -1
            self.inputs_released.left = false
            self.player_face_dir.x = -1
        end
		if action.released then
			if not self.inputs_released.right then
                self.input.x = 1
            else
                self.input.x = 0
            end
            self.inputs_released.left = true
		end
	elseif action_id == input_right then
		if action.pressed then
			self.input.x = 1
            self.inputs_released.right = false
            self.player_face_dir.x = 1
        end
		if action.released then
			if not self.inputs_released.left then
                self.input.x = -1
            else
                self.input.x = 0
            end
            self.inputs_released.right = true
		end
	elseif action_id == input_up then
        if action.pressed then
            self.input.y = 1
            self.inputs_released.up = false
        end
        if action.released then
            if not self.inputs_released.down then
                self.input.y = -1
            else
                self.input.y = 0
            end
            self.inputs_released.up = true
        end
    elseif action_id == input_down then
        if action.pressed then
            self.input.y = -1
            self.inputs_released.down = false
        end
        if action.released then
            if not self.inputs_released.up then
                self.input.y = 1
            else
                self.input.y = 0
            end
            self.inputs_released.down = true
        end
	end
    -- Si hay movimiento, cambiar la dirección y la animación
    local size_vector = vmath.length(self.input)
    if size_vector > 0 then
        self.moving = true
        self.dir = vmath.normalize(self.input)  -- Normalizamos el vector de dirección

        -- Cambiar la animación de acuerdo con la dirección y checa si va izquierda o derecha
        if self.dir.y > 0 and self.player_face_dir.x > 0 then
            print("walk_up_right")
            play_animation(self, "walk_up_right")
        elseif self.dir.y > 0 and self.player_face_dir.x < 0 then
            print("walk_up_left")
            play_animation(self, "walk_up_left")
        elseif self.dir.y < 0 and self.player_face_dir.x > 0 then
            print("walk_down_right")
            play_animation(self, "walk_down_right")
        elseif self.dir.y < 0 and self.player_face_dir.x < 0 then
            print("walk_down_left")
            play_animation(self, "walk_down_left")
        elseif self.dir.x > 0 then
            play_animation(self, "walk_right")
        elseif self.dir.x < 0 then
            play_animation(self, "walk_left")
        end
    else
        self.moving = false
        -- Si esta viendo a la derecha, poner la animación en idle normal y si esta viendo a la izquierda, poner la animación en idle mirando a la izquierda
        if self.player_face_dir.x > 0 then
            play_animation(self, "idle")
        else
            play_animation(self, "idle_left")
        end
    end
end

function play_animation(self, animation)
    -- Solo cambia la animación si es diferente de la actual
    if self.current_animation ~= animation then
        msg.post("#sprite", "play_animation", { id = hash(animation) })
        self.current_animation = animation
    end
end
