function set_properties(self)
    self.max_health = 100           -- Salud máxima del jugador
    self.max_energy = 50            -- Energía máxima
    
    -- Atributos de combate
    self.attack_power = 10          -- Poder de ataque (daño que inflige)
    self.attack_speed = 1           -- Velocidad de ataque (segundos entre ataques)
    self.attack_range = 30          -- Rango de ataque (distancia máxima)
    self.attack_cooldown = 1        -- Tiempo de recuperación tras atacar (en segundos)
	self.attacking = false          -- Estado de ataque (verdadero si se encuentra atacando)
   
end

function barbarian_attack(self)
	local properties = {
		attack_cooldown = self.attack_cooldown,
		attacking = self.attacking,
		last_attack_time = self.last_attack_time
	}
	-- Call Attack animation
	Combat.attack(self, properties)
end
