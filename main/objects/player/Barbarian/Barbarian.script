
local function_registry = require "main.function_registry"

local Combat = require "main/objects/player/Combat"


function init(self)
	-- Add initialization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
    self.player_id = tostring(go.get_id("Player")) -- ID del padre (Player)

    -- Registra la función personalizada
    function_registry.register(self.player_id, "attack", barbarian_attack)
	-- Set properties
	set_properties(self)
end



