function on_message(self, message_id, message, sender)
	-- Add message-handling code here
	-- Learn more: https://defold.com/manuals/message-passing/
	-- Remove this function if not needed
	if message_id == hash("update") then
		self.attacking = message.attacking
		print("Attacking: " .. tostring(self.attacking))
		local properties = {
			attack_cooldown = message.attack_cooldown,
			attacking = message.attacking,
			last_attack_time = message.last_attack_time
		}
        custom_update(self, message.dt, properties)
    end

	if message_id == hash("init_player_vars") then
        -- Accede al padre (Player) y sobrescribe las variables
        local parent = go.get_id("Player")
        msg.post(parent, "set_player_vars", { 
			max_health = self.max_health, 
			max_energy = self.max_energy, 
			attack_power = self.attack_power, 
			attack_range = self.attack_range,
			attack_speed = self.attack_speed,
			attack_cooldown = self.attack_cooldown
		})
    end

	--check collision
    if message_id == hash("contact_point_response") then
		local parent = go.get_id("Player")
		if message.group == hash("enemy") then
			print("Colisionaste con un enemigo!")
			--[[ if not self.invulnerable then
				self.health = self.health - 10
				print("Salud restante: " .. self.health)
			end ]]
			
			-- Calcular dirección de empuje
			local player_pos = go.get_position() -- Posición del jugador

			local enemy_pos = message.position -- Posición del enemigo (de la colisión)
			local push_direction = vmath.normalize(enemy_pos - player_pos) -- Dirección hacia atrás
			
			-- Enviar mensaje al enemigo con la dirección y fuerza del empuje
			msg.post(message.other_id, "apply_push", { direction = push_direction, force = 200 })
		end
    end

end

