local enemy_manager = require "main/enemy_manager"

local wave_data = {
	current_wave = 1,     -- Número de la oleada actual
	enemies_per_wave = 1, -- Enemigos por oleada inicial
	spawn_interval = 0.2, -- Tiempo entre cada aparición de enemigo
	wave_interval = 5.0,  -- Tiempo entre oleadas
	difficulty_scale = 1.2 -- Escalado de dificultad (opcional)
}

local active_enemies = 0  -- Contador de enemigos activos
-- Lista global de enemigos activos
local active_enemies_list = {}
-- Referencia al enemy_factory
local enemy_factory_url = "/enemies#enemy_factory"
local player_url = nil

-- Generar un enemigo en una posición aleatoria
local function spawn_enemy()
	local x = math.random(350, 680) -- Coordenadas X aleatorias (ajusta según tu juego)
	local y = math.random(194, 600) -- Coordenadas Y aleatorias
	local position = vmath.vector3(x, y, 0)

	-- Crear enemigo desde el factory
	local enemy = collectionfactory.create(enemy_factory_url, position)
	active_enemies = active_enemies + 1 -- Incrementar el contador de enemigos activos
	-- Escuchar cuando el enemigo sea destruido
	msg.post(enemy[hash("/enemy")], "set_enemy_type_x", { type = "goblin", url = msg.url(enemy[hash("/enemy")]), player_url = player_url })
	-- Agregar a la lista de enemigos activos
	table.insert(active_enemies_list, { url = enemy[hash("/enemy")], type = "goblin" })
	enemy_manager.add_enemy(msg.url(enemy[hash("/enemy")]))
end

-- Iniciar una oleada
local function start_wave()
	print("Starting wave:", wave_data.current_wave)
	for i = 1, wave_data.enemies_per_wave do
		timer.delay(wave_data.spawn_interval * i, false, function()
			spawn_enemy()
		end)
	end
end

-- Verificar si la oleada ha terminado
local function check_wave_end()
	if active_enemies <= 0 then
		print("Wave complete!")
		wave_data.current_wave = wave_data.current_wave + 1 -- Siguiente oleada
		wave_data.enemies_per_wave = math.ceil(wave_data.enemies_per_wave * wave_data.difficulty_scale) -- Aumentar enemigos
		timer.delay(wave_data.wave_interval, false, start_wave) -- Esperar antes de iniciar la siguiente oleada
	end
end

-- Cuando un enemigo es destruido
local function on_enemy_destroyed()
	active_enemies = active_enemies - 1
	check_wave_end()
end

-- Agregar un enemigo a la lista
function add_enemy(enemy_url)
    table.insert(active_enemies_list, enemy_url)
end
-- Eliminar un enemigo de la lista
function remove_enemy(enemy_url)
    for i, url in ipairs(active_enemies_list) do
        if url == enemy_url then
            table.remove(active_enemies_list, i)
            break
        end
    end
	enemy_manager.remove_enemy(enemy_url)
end

-- Obtener todos los enemigos activos
function get_active_enemies()
    return active_enemies_list
end

-- Función para limpiar la lista de enemigos (opcional)
function clear_enemies()
    active_enemies_list = {}
end

function init(self)
	-- Escuchar mensajes de enemigos destruidos
	msg.post(".", "acquire_input_focus")
	start_wave()
end

function on_message(self, message_id, message, sender)
	if message_id == hash("player_created") then
		-- Guarda la URL del jugador
		player_url = message.player_url
        -- Notifica a todos los enemigos sobre el jugador
        for _, enemy in ipairs(active_enemies_list) do
            msg.post(enemy, "player_created", { player_url = message.player_url })
        end
    end
	if message_id == hash("enemy_destroyed") then
		on_enemy_destroyed()
	end
	if message_id == hash("add_enemy") then
        add_enemy(message.enemy_url)
    elseif message_id == hash("remove_enemy") then
        remove_enemy(message.enemy_url)
    elseif message_id == hash("get_active_enemies") then
        -- Devuelve la lista de enemigos activos
        msg.post(sender, "active_enemies", { enemies = active_enemies_list })
    end
end
